APP_NAME=vaultigen
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Background imports require a running queue worker. The database queue's
# retry_after defaults to VAULTIGEN_IMPORT_JOB_TIMEOUT + 60 so a long import job
# is never handed to a second worker. Only override these if you change the
# import timeout or run the queue on a different driver.
# DB_QUEUE_RETRY_AFTER=3660
# VAULTIGEN_IMPORT_JOB_TIMEOUT=3600
# VAULTIGEN_IMPORT_QUEUE_TIMEOUT=3600

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# DANGER: disables multi-factor authentication entirely. Development/local use
# only. The application refuses to start with this enabled outside APP_ENV
# local/testing. Never set this in production.
# VAULTIGEN_MFA_DISABLED=false

# Installation keys are created by vaultigen:initialize in storage/app/private.
# A host that cannot mount a protected file may instead provide the KEK keyring
# through the environment (weaker isolation; see README):
# VAULTIGEN_INSTALLATION_ID=
# VAULTIGEN_AUDIT_KEY=
# PASSKEYS_USER_HANDLE_SECRET=
# VAULTIGEN_KEK_PROVIDER=environment
# VAULTIGEN_KEK_KEYRING={"active_key_id":"kek-...","keys":{"kek-...":"<base64 32-byte key>"}}

# Optional license, instead of installing it on the settings page. Put the
# whole block on one line in double quotes; whitespace inside it is ignored:
# VAULTIGEN_LICENSE="-----BEGIN VAULTIGEN LICENSE----- ... -----END VAULTIGEN LICENSE-----"

# Encrypted attachment limits, in bytes. Defaults are 25 MB per file and
# 500 MB per vault. Raise the per-file value only within PHP's
# upload_max_filesize and post_max_size; see the README for details.
# VAULTIGEN_ATTACHMENT_MAX_BYTES=26214400
# VAULTIGEN_VAULT_ATTACHMENT_MAX_BYTES=524288000

# Backup encryption key. It is separate from the installation KEK and is
# created by vaultigen:backup-key:generate in storage/app/private. Escrow it
# apart from the backups and the live keyring. A host that cannot mount a
# protected file may provide the keyring through the environment:
# VAULTIGEN_BACKUP_KEY_FILE=/absolute/path/to/backup.json
# VAULTIGEN_BACKUP_KEYRING={"active_key_id":"backup-...","keys":{"backup-...":"<base64 32-byte key>"}}

# Where finished backup sets are written. Copy them off-host afterwards.
# VAULTIGEN_BACKUP_ROOT=/absolute/path/to/backups
# Private, disk-backed staging. Allow space for both plaintext and encrypted dumps.
# VAULTIGEN_BACKUP_TEMPORARY_ROOT=/absolute/path/to/private/backup-work
# Uses the existing scheduler and durable queue. Disable an old backup cron first.
# VAULTIGEN_BACKUP_SCHEDULE_ENABLED=false
# VAULTIGEN_BACKUP_SCHEDULE="30 2 * * *"
# VAULTIGEN_BACKUP_TIMEZONE=UTC
# VAULTIGEN_BACKUP_MAX_AGE_HOURS=48
# Local deletion is opt-in and never replaces off-host copying.
# VAULTIGEN_BACKUP_RETENTION_ENABLED=false
# VAULTIGEN_BACKUP_RETENTION_DAYS=30

# Deployment hardening. Leave the first two unset unless the application runs
# behind a reverse proxy or your web server cannot restrict the Host header.
# Proxies are a comma-separated list of IPs or CIDR ranges; hosts are regular
# expressions. See https://vaultigen.com/docs/hardening.
# VAULTIGEN_TRUSTED_PROXIES=
# VAULTIGEN_TRUSTED_HOSTS=
# HSTS is sent only over HTTPS. Set the max age to 0 to disable it, and keep
# include_subdomains off unless every subdomain also serves HTTPS.
# VAULTIGEN_HSTS_MAX_AGE=31536000
# VAULTIGEN_HSTS_INCLUDE_SUBDOMAINS=false
# VAULTIGEN_HSTS_PRELOAD=false

# Free-space warning threshold for the volume that holds the database,
# attachments, and backup sets. The Installation status page warns below this.
# VAULTIGEN_STORAGE_PATH=/absolute/path/to/storage/app/private
# VAULTIGEN_MIN_FREE_BYTES=268435456

# Queue worker timeouts for backup and key rotation. The queue connection's
# retry_after must exceed these so a long run is not handed to a second worker.
# VAULTIGEN_BACKUP_JOB_TIMEOUT=3600
# VAULTIGEN_ROTATION_JOB_TIMEOUT=3600

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

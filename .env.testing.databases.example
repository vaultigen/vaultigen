# Credentials for running the test suite against real databases.
#
# Copy this file to .env.testing.databases (gitignored) and fill in the
# databases that are already available on your machine. Only the runner reads
# this file; Laravel never loads it (it is not .env or .env.testing).
#
# DB_TEST_DRIVERS lists the drivers to run, in order.
# Each driver needs a DB_TEST_<DRIVER>_* block, where <DRIVER> is upper-cased.
#
# The test database must already exist before the first run; RefreshDatabase
# migrates it and rolls each test back afterwards.
#
# The host and port must be reachable from wherever PHP runs:
#   - native PHP on the host       -> 127.0.0.1
#   - PHP inside a container       -> the container/service name
#
# An empty DB_TEST_<DRIVER>_DATABASE marks the driver as not configured.

DB_TEST_DRIVERS="mysql pgsql"

DB_TEST_MYSQL_CONNECTION=mysql
DB_TEST_MYSQL_HOST=127.0.0.1
DB_TEST_MYSQL_PORT=3306
DB_TEST_MYSQL_DATABASE=vaultigen_test
DB_TEST_MYSQL_USERNAME=root
DB_TEST_MYSQL_PASSWORD=

DB_TEST_PGSQL_CONNECTION=pgsql
DB_TEST_PGSQL_HOST=127.0.0.1
DB_TEST_PGSQL_PORT=5432
DB_TEST_PGSQL_DATABASE=vaultigen_test
DB_TEST_PGSQL_USERNAME=postgres
DB_TEST_PGSQL_PASSWORD=

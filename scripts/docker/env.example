# Vaultigen Docker Compose configuration. Keep an off-server copy of this file.
# Values are literal and never run by a shell. Put any value containing $, #,
# spaces, or quotes inside single quotes; escape an apostrophe as \'.

# Exact image release for every application service. Changing it is an update.
VAULTIGEN_IMAGE_TAG=1.0.0

# Public hostname. DNS must point to this server; ports 80 and 443 must reach it.
VAULTIGEN_DOMAIN=vault.example.com

# Password of the included PostgreSQL database. Replace it before setup:
#   sed -i "s/^DB_PASSWORD=.*/DB_PASSWORD=$(openssl rand -hex 32)/" .env
# Setup refuses this placeholder or any value shorter than 24 characters.
# Keep it unchanged after installation.
DB_PASSWORD=change-me

# Outgoing mail (invitations, recovery, notifications). For implicit TLS on
# port 465 also set MAIL_SCHEME=smtps.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME='vaultigen@example.com'
MAIL_PASSWORD='your-smtp-password'
MAIL_FROM_ADDRESS=vaultigen@example.com
MAIL_FROM_NAME='Vaultigen'

APP_LOCALE=en

# Nightly verified backup into ./backups. Set ENABLED=false to disable.
VAULTIGEN_BACKUP_SCHEDULE_ENABLED=true
VAULTIGEN_BACKUP_SCHEDULE='30 2 * * *'
VAULTIGEN_BACKUP_TIMEZONE=UTC
# Local deletion of old sets stays off until you enable it.
# VAULTIGEN_BACKUP_RETENTION_ENABLED=true
# VAULTIGEN_BACKUP_RETENTION_DAYS=30

# Optional settings.
# VAULTIGEN_LICENSE='...'
# VAULTIGEN_ATTACHMENT_MAX_BYTES=26214400
# VAULTIGEN_TRUSTED_HOSTS='^vault\.example\.com$'

# Existing reverse proxy: download compose.proxy.yaml and uncomment.
# COMPOSE_FILE=compose.yaml:compose.proxy.yaml
# Only if 172.31.250.0/24 collides with another network on this server:
# VAULTIGEN_NETWORK_SUBNET=172.31.250.0/24
# VAULTIGEN_NETWORK_GATEWAY=172.31.250.1
# Only for a proxy in another container or on another host:
# VAULTIGEN_TRUSTED_PROXIES=
